# Anthropic — used by FastAPI service (Haiku extraction) and extract_features.py
ANTHROPIC_API_KEY=sk-ant-...

# Auth token callers must send to YOUR Rails endpoint
GAUNTLET_PRICING_SECRET=choose-a-strong-secret

# HouseAccount staging (pro.houseparty.dev)
HA_APP_NAME=gauntlet
HA_SIGNING_SECRET=provided-by-claudio

# Service URLs (defaults — only override if running on non-standard ports)
RAILS_URL=http://localhost:3000
PRICING_SERVICE_URL=http://localhost:8000/predict
